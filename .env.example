# =============================================================================
# DataPilot configuration — copy this file to `.env` and fill in real values.
# The app reads these from the environment at startup.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — OpenRouter API key (https://openrouter.ai/keys)
# 1. Create a free account at https://openrouter.ai
# 2. Add a small credit (min ~$5) at https://openrouter.ai/settings/credits
# 3. Create an API key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=your_key_here

# -----------------------------------------------------------------------------
# Model selection.
# OpenRouter model IDs for open 7-9B models (swap freely, no code change):
#   google/gemma-4-26b-a4b-it:free      — fast, free (current default)
#   google/gemma-4-31b-it:free          — bigger, free (rate-limited)
#   meta-llama/llama-3.1-8b-instruct    — 8B, solid structured output (paid)
#   mistralai/mistral-7b-instruct       — 7B (paid)
#   deepseek/deepseek-chat              — cheap, strong reasoning (paid)
# :free models are reverse-proxied free tiers — they work but are rate-limited
# (429). For reliable volume use a paid model with your own credits.
# -----------------------------------------------------------------------------
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# -----------------------------------------------------------------------------
# OPTIONAL — these are reported to OpenRouter for attribution (they rank/discount
# apps that send them). Not required for function.
# -----------------------------------------------------------------------------
OPENROUTER_HTTP_REFERER=https://github.com/yourname/datapilot
OPENROUTER_APP_NAME=DataPilot

# -----------------------------------------------------------------------------
# OPTIONAL — behavior toggles
# -----------------------------------------------------------------------------
# Turn the whole AI layer off to run a pure deterministic data engine.
DATAPILOT_AI_ENABLED=true

# Logging: DEBUG, INFO, WARNING, ERROR
DATAPILOT_LOG_LEVEL=INFO

# Timeout for a single LLM call, in seconds.
OPENROUTER_TIMEOUT=60